{
  "name": "pfmea-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c teal,cyan \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "create-samples": "python3 scripts/create_samples.py && python3 scripts/create_sample_pdfs.py"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^8.3.6"
  }
}
